{
  "name": "codemaker-hub-light",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "账号登录 / 本地代理 / 用量统计的 Windows 桌面应用（Tauri + React）",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CMHubLight/codemaker-hub-light.git"
  },
  "homepage": "https://github.com/CMHubLight/codemaker-hub-light#readme",
  "bugs": {
    "url": "https://github.com/CMHubLight/codemaker-hub-light/issues"
  },
  "keywords": [
    "tauri",
    "llm-proxy",
    "usage-tracking",
    "openai",
    "anthropic",
    "windows"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc && vite build",
    "build:guarded": "node scripts/ensure-app-closed.mjs && pnpm build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:scripts": "node --test scripts/ensure-app-closed.test.mjs",
    "test:watch": "vitest",
    "docs:check": "node scripts/check-public-repo.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:scripts && pnpm build && pnpm docs:check",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  }
}
